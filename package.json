{
  "name": "amar-manager-v2-backend",
  "description": "Cloudflare Workers with D1 Database",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:local": "wrangler d1 migrations apply amar-manager-v2 --local",
    "db:migrate": "wrangler d1 migrations apply amar-manager-v2",
    "db:migrate:staging": "wrangler d1 migrations apply amar-manager-v2-stage --env staging"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "hono": "^4.6.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  },
  "private": true
}
